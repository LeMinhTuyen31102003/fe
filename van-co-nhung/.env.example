# Copy this file to .env and fill in real values for local development.
# In production (Vercel), configure these as environment variables in the
# project dashboard instead.

# Backend API base URL (leave empty to call same-origin /api).
VITE_API_BASE_URL=http://localhost:8080

# Cloudinary — used for students to upload a photo of their assignment
# submission directly from the browser (unsigned upload preset).
# Dashboard: https://cloudinary.com/console -> Settings -> Upload -> Upload presets
# (create a preset with Signing Mode = Unsigned).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
